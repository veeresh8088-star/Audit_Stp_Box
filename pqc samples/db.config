# generated 2026-08-25, TLSRef Guideline v6.0, PostgreSQL 17.2, OpenSSL 4.0.1, intermediate config, gitrev=d96f668
# https://configurator.tlsref.org/#server=postgresql&version=17.2&config=intermediate&openssl=4.0.1&guideline=6.0
ssl = on

ssl_cert_file = '/path/to/signed_cert_plus_intermediates'
ssl_key_file = '/path/to/private_key'

ssl_min_protocol_version = 'TLSv1.2'
ssl_ciphers = 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305'